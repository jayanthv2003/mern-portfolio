# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# DATABASE (MongoDB Atlas)
# Get this from Atlas -> Connect -> Drivers
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/portfolio?retryWrites=true&w=majority

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Used only once by `npm run seed:admin` to create the first admin user
ADMIN_NAME=Jayanth
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ==========================================
# EMAIL (Nodemailer) - Gmail example
# Use a Google "App Password", not your real password
# ==========================================
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_RECEIVER=your_email@gmail.com

# ==========================================
# CORS - comma separated list of allowed origins
# ==========================================
CLIENT_URL=http://localhost:5173

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
